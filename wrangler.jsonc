// Cloudflare Workers static-assets deploy. The build command copies the site
// files into dist/ (see DEPLOYMENT.md), so the repository itself — .git,
// Docker files, docs — is never uploaded. "name" must match the Worker's name
// in the Cloudflare dashboard.
{
  "name": "topstaging",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
